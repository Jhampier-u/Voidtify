# Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm API (https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3210

# Secreto del endpoint de captura (/api/cron/capture).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Zona horaria IANA para local_date y local_hour — p. ej. America/Lima,
# Europe/Madrid. Obligatoria. Cambiarla obliga a recalcular desde /ajustes.
STATS_TZ=

# Quién puede iniciar sesión, por id de usuario de Spotify, separados por comas.
# Si se deja vacío, la instancia se queda con el primero que entre y a partir de
# ahí rechaza a cualquier otra cuenta. Sin esto, cualquiera que complete el
# OAuth con su propia cuenta vería el historial entero.
ALLOWED_SPOTIFY_USER_IDS=
